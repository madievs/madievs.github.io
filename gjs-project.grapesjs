[{"type":"textnode","content":"segment about how its relaxing to crochet and listen to a podcast or audio books\n                "}]},{"type":"text","attributes":{"id":"i0uy4s"},"components":[{"type":"textnode","content":"<— images of things ive crocheted, apparently no pictures of anything ive made in the past?! i usually give them away, so we need to wait til i finish my current project"}]},{"tagName":"p"},{"name":"Project Role","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"My role & collaborators"}]},{"tagName":"p","type":"text","name":"Editable Project Role","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 02 role","data-field":"project-02-role","id":"ilu8tt"},"components":[{"type":"textnode","content":"yadaya"}]}]},{"name":"Project Methods","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Tools & methods"}]},{"tagName":"p","type":"text","name":"Editable Project Methods","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 02 tools and methods","data-field":"project-02-tools","id":"ivtplp"},"components":[{"type":"textnode","content":"[Tools, matyadayaerials, analytical techniques, or technologies]"}]}]},{"name":"Project Outcomes","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Outcomes & learning"}]},{"tagName":"p","type":"text","name":"Editable Project Outcomes","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Project 02 outcomes","data-field":"project-02-outcomes","id":"i6ozdj"},"components":[{"type":"textnode","content":"yadayda"}]}]}]}]},{"tagName":"article","name":"Third Project Card","classes":["gjs-t-border","project-showcase-card"],"attributes":{"data-js":"project-card","data-project":"03","aria-label":"Project 03"},"components":[{"name":"Project Image Panel","classes":["project-showcase-media"],"components":[{"name":"Project Image Placeholder","classes":["project-image-slot"],"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 03 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","name":"Image Placeholder Icon","resizable":{"ratioDefault":1},"attributes":{"src":"https://api.iconify.design/lucide-image.svg?color=%23517269","width":"32","height":"32","alt":"","loading":"lazy"}},{"tagName":"span","type":"text","name":"Image Placeholder Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Project 03 image"}]},{"tagName":"p","type":"text","name":"Image Guidance","classes":["project-image-hint"],"components":[{"type":"textnode","content":"Highlight an experiment, a final outcome, or work in progress."}]}]},{"type":"label","name":"Upload Project Image","classes":["project-image-upload","editor-control"],"components":[{"type":"textnode","content":"Add or replace image\n                  "},{"type":"input","name":"Project Image File Input","void":true,"classes":["project-image-input"],"attributes":{"type":"file","accept":"image/jpeg,image/png,image/webp","data-js":"upload","aria-label":"Choose an image for project 03"}}]},{"tagName":"p","type":"text","name":"Image Upload Status","classes":["project-image-status","editor-control"],"attributes":{"data-js":"image-status","aria-live":"polite"},"components":[{"type":"textnode","content":"JPEG, PNG, or WebP · up to 3 MB"}]}]},{"name":"Project Details","classes":["project-showcase-content"],"components":[{"tagName":"h3","type":"heading","name":"Editable Project Title","classes":["project-showcase-title","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 03 title","data-field":"project-03-name","id":"ilnggm"},"components":[{"type":"textnode","content":"Muay Thai"}]},{"tagName":"p","type":"text","name":"Editable Detailed Description","classes":["project-showcase-description","project-customizable"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Project 03 detailed description","data-field":"project-03-description","id":"imej2v"},"components":[{"type":"textnode","content":"yada yada yada stress relief and exercise\n                "}]},{"type":"text","attributes":{"id":"itjhfj"},"components":[{"tagName":"br","void":true,"attributes":{"id":"iu11fg"}},{"type":"textnode","content":"< do not know if a picture of me fighting is actually appropriate so probably just one of everyone together, will need to come later because im on a hiatus till graduation\n                "}]},{"tagName":"p"},{"name":"Project Role","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"attributes":{"id":"i7yah6"},"components":[{"type":"textnode","content":"My role & collaborators"}]},{"tagName":"p","type":"text","name":"Editable Project Role","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 03 role","data-field":"project-03-role","id":"i21m83"},"components":[{"type":"textnode","content":"yadayada"}]}]},{"name":"Project Methods","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Tools & methods"}]},{"tagName":"p","type":"text","name":"Editable Project Methods","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 03 tools and methods","data-field":"project-03-tools","id":"ikjxq8"},"components":[{"type":"textnode","content":"yadayada"}]}]},{"name":"Project Outcomes","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Outcomes & next steps"}]},{"tagName":"p","type":"text","name":"Editable Project Outcomes","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Project 03 outcomes","data-field":"project-03-outcomes","id":"imjxbz"},"components":[{"type":"textnode","content":"yadaydaa"}]}]}]}]}]},{"type":"script","name":"Project Image Upload Behavior","attributes":{"data-scope":"project-showcase"},"components":[{"type":"textnode","content":"\n            (() => {\n              const root = document.querySelector('[data-js=\"project-showcase\"]');\n              if (!root) return;\n              root.querySelectorAll('[data-js=\"project-card\"]').forEach(card => {\n                const input = card.querySelector('[data-js=\"upload\"]');\n                const preview = card.querySelector('[data-js=\"preview\"]');\n                const status = card.querySelector('[data-js=\"image-status\"]');\n                const key = 'personal-project-image-' + card.dataset.project;\n                const show = image => {\n                  preview.src = image;\n                  preview.hidden = false;\n                };\n                try {\n                  const previous = localStorage.getItem(key);\n                  if (previous) show(previous);\n                } catch (error) {}\n                input.addEventListener('change', () => {\n                  const file = input.files[0];\n                  if (!file) return;\n                  if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 3 * 1024 * 1024) {\n                    status.textContent = 'Choose a JPEG, PNG, or WebP image up to 3 MB.';\n                    input.value = '';\n                    return;\n                  }\n                  const reader = new FileReader();\n                  reader.onerror = () => status.textContent = 'Unable to read this image. Please try another file.';\n                  reader.onload = () => {\n                    show(reader.result);\n                    try {\n                      localStorage.setItem(key, reader.result);\n                      status.textContent = 'Image saved in this browser.';\n                    } catch (error) {\n                      status.textContent = 'Image added, but browser storage is full or unavailable. Print to keep a copy.';\n                    }\n                  };\n                  reader.readAsDataURL(file);\n                });\n              });\n            })();\n          "}]}]},{"tagName":"section","name":"Project Context Section","classes":["project-story-section"],"attributes":{"aria-labelledby":"project-context-heading","id":"i6hr4g-2","hidden":true}},{"tagName":"section","name":"Explore Portfolio","classes":["project-next-step","gjs-t-border"],"components":[{"tagName":"p","type":"text","name":"Explore Eyebrow","classes":["project-story-label"],"components":[{"type":"textnode","content":"Keep exploring"}]},{"tagName":"h2","type":"heading","name":"Explore Heading","classes":["gjs-t-h2"],"components":[{"type":"textnode","content":"Get to know the person behind the projects."}]},{"name":"Portfolio Links","classes":["project-page-actions"],"components":[{"type":"link","name":"About Me Link","classes":["gjs-t-button","project-page-button"],"attributes":{"href":"./cv.html","id":"i52xl9"},"components":[{"type":"textnode","content":"More about my projects"}]},{"type":"link","name":"CV Link","classes":["gjs-t-link","project-return-link"],"attributes":{"href":"./index.html","id":"i8wv3p"},"components":[{"type":"textnode","content":"View my CV →"}]}]}]},{"tagName":"footer","classes":["document-footer"],"attributes":{"id":"page-footer"},"components":[{"tagName":"span","type":"text","attributes":{"id":"i25lqg"},"components":[{"type":"textnode","content":"A work in progress. Always learning."}]},{"type":"link","classes":["gjs-t-link","back-to-top-link"],"attributes":{"id":"i4wj8f","href":"#cv"},"components":[{"type":"textnode","content":"Back to top ↑"}]}]}]}]},{"type":"script","name":"CV Editing and Printing","components":[{"type":"textnode","content":"\n      (() => {\n        const storageKey = 'personal-cv-content-v1';\n        const fields = [...document.querySelectorAll('[data-field]')];\n        const status = document.getElementById('save-status');\n        let saved = {};\n        try {\n          saved = JSON.parse(localStorage.getItem(storageKey) || '{}');\n          fields.forEach(field => {\n            if (typeof saved[field.dataset.field] === 'string') field.textContent = saved[field.dataset.field];\n          });\n        } catch (error) {\n          status.textContent = 'Browser storage is unavailable. Print to keep a copy.';\n        }\n        let timer;\n        fields.forEach(field => {\n          field.addEventListener('input', () => {\n            status.textContent = 'Saving your changes…';\n            clearTimeout(timer);\n            timer = setTimeout(() => {\n              fields.forEach(item => saved[item.dataset.field] = item.textContent);\n              try {\n                localStorage.setItem(storageKey, JSON.stringify(saved));\n                status.textContent = 'Saved in this browser. Your changes stay on this device.';\n              } catch (error) {\n                status.textContent = 'Unable to save locally. Print to keep a copy.';\n              }\n            }, 400);\n          });\n          field.addEventListener('paste', event => {\n            event.preventDefault();\n            const text = event.clipboardData.getData('text/plain');\n            const selection = window.getSelection();\n            if (!selection.rangeCount) return;\n            const range = selection.getRangeAt(0);\n            range.deleteContents();\n            const node = document.createTextNode(text);\n            range.insertNode(node);\n            range.setStartAfter(node);\n            range.collapse(true);\n            selection.removeAllRanges();\n            selection.addRange(range);\n            field.dispatchEvent(new Event('input', {\n              bubbles: true\n            }));\n          });\n        });\n\n        const photo = document.getElementById('profile-photo');\n        try {\n          const previousPhoto = localStorage.getItem('personal-cv-photo-v1');\n          if (previousPhoto) {\n            photo.src = previousPhoto;\n            photo.classList.remove('p-5');\n            photo.alt = 'Personal profile photo';\n          }\n        } catch (error) {}\n        document.getElementById('photo-input').addEventListener('change', event => {\n          const file = event.target.files[0];\n          if (!file) return;\n          if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {\n            status.textContent = 'Please choose a JPEG, PNG, or WebP photo.';\n            return;\n          }\n          if (file.size > 3 * 1024 * 1024) {\n            status.textContent = 'Please choose a photo smaller than 3 MB.';\n            return;\n          }\n          const reader = new FileReader();\n          reader.onload = () => {\n            photo.src = reader.result;\n            photo.alt = 'Personal profile photo';\n            photo.classList.remove('p-5');\n            try {\n              localStorage.setItem('personal-cv-photo-v1', reader.result);\n              status.textContent = 'Photo saved in this browser.';\n            } catch (error) {\n              status.textContent = 'Photo added, but could not be saved locally.';\n            }\n          };\n          reader.readAsDataURL(file);\n        });\n\n        const menu = document.getElementById('more-menu');\n        menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => menu.open = false));\n        document.addEventListener('click', event => {\n          if (!menu.contains(event.target)) menu.open = false;\n        });\n        document.addEventListener('keydown', event => {\n          if (event.key === 'Escape') menu.open = false;\n        });\n\n        const panel = document.getElementById('profile-panel');\n        const hiddenForPrint = [\n          document.getElementById('site-header'),\n          document.getElementById('page-footer'),\n          ...document.querySelectorAll('.editor-control')\n        ];\n        let printing = false;\n        let previousDetails = [];\n        const preparePrint = () => {\n          if (printing) return;\n          printing = true;\n          if (document.activeElement) document.activeElement.blur();\n          hiddenForPrint.forEach(element => element.hidden = true);\n          panel.classList.remove('sticky');\n          panel.classList.add('static');\n          previousDetails = [...document.querySelectorAll('#projects details')].map(element => [element, element.open]);\n          previousDetails.forEach(([element]) => element.open = true);\n        };\n        const restorePrint = () => {\n          hiddenForPrint.forEach(element => element.hidden = false);\n          panel.classList.remove('static');\n          panel.classList.add('sticky');\n          previousDetails.forEach(([element, open]) => element.open = open);\n          printing = false;\n        };\n        window.addEventListener('beforeprint', preparePrint);\n        window.addEventListener('afterprint', restorePrint);\n        document.getElementById('print-button').addEventListener('click', () => {\n          preparePrint();\n          window.print();\n          restorePrint();\n        });\n      })();\n    "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","name":"Document Head","compone