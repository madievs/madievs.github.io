e":"p","type":"text","classes":["project-showcase-value","project-customizable"],"attributes":{"id":"ii8dk6-2-2","role":"textbox","aria-label":"Project 01 tools and methods","data-field":"project-tools"},"components":[{"type":"textnode","content":"Naps, Kisses, Tag"}]}]},{"name":"Project Outcomes","classes":["project-showcase-field"],"attributes":{"id":"ip6fxan"}}]}]},{"tagName":"article","classes":["gjs-t-border","project-showcase-card"],"attributes":{"id":"isq3n4-2-2-2","aria-labelledby":"i9olr4","data-js":"project-card","data-project":"01"},"components":[{"name":"Project Image Panel","classes":["project-showcase-media"],"attributes":{"id":"ity1ph-2-6"},"components":[{"name":"Project Image Placeholder","classes":["project-image-slot"],"attributes":{"id":"ivmiqh4-6"},"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 01 image","hidden":true,"src":"data:image/svg+xml;base64,","id":"i5dmnh"}},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/6619e957-791c-4c0f-9997-fd537d14c8a3__screenshot-2026-10-27-at-18-05-00-photo-google-photos.png","id":"iklqf55-7"}}]},{"name":"Project Image Placeholder","classes":["project-image-slot"],"attributes":{"id":"i0y76vv-6"},"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 01 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/d3bd8665-974c-454c-84aa-98e17d64d6c1__screenshot-2026-10-27-at-18-04-42-photo-google-photos.png","id":"iieat4p-2"}}]},{"name":"Project Image Placeholder","classes":["project-image-slot"],"attributes":{"id":"i0y76vv-6-2"},"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 01 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/faf38eff-d181-4f2f-b9bb-05dba05b5ab8__screenshot-2026-10-27-at-18-19-30-photo-google-photos.png","id":"iieat4p-2-4"}}]}]},{"name":"Project Details","classes":["project-showcase-content"],"attributes":{"id":"iy7xwv-2-2"},"components":[{"tagName":"h3","type":"heading","classes":["project-showcase-title","project-customizable"],"attributes":{"id":"i9olr4-2-2-2","role":"textbox","aria-label":"Project 01 title","data-field":"project-name"},"components":[{"type":"textnode","content":"Research Experience"}]},{"tagName":"p","type":"text","classes":["project-showcase-description","project-customizable"],"attributes":{"id":"ie43b5-2-2-2","role":"textbox","aria-multiline":"true","aria-label":"Project 01 detailed description","data-field":"project-description"},"components":[{"type":"textnode","content":"I’ve spent the past 9 months conducting and documenting an insurmountable about of sensory research. My primary focus is the taste and texture of various object I find out on adventures. "}]},{"name":"Project Role","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"attributes":{"id":"ilbh2vn-2"},"components":[{"type":"textnode","content":"collaborators"}]},{"tagName":"p","type":"text","name":"Editable Project Role","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 01 role","data-field":"project-01-role","id":"ips5pvj-2"},"components":[{"type":"textnode","content":"Madeline van Staveren and Rose Charbonnou"}]}]},{"name":"Project Methods","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","classes":["project-story-label"],"attributes":{"id":"iovndo-2-2-2"},"components":[{"type":"textnode","content":"Tools & methods"}]},{"tagName":"p","type":"text","classes":["project-showcase-value","project-customizable"],"attributes":{"id":"ii8dk6-2-2-2","role":"textbox","aria-label":"Project 01 tools and methods","data-field":"project-tools"},"components":[{"type":"textnode","content":"Licking and Biting"}]}]},{"name":"Project Outcomes","classes":["project-showcase-field"],"attributes":{"id":"ip6fxan-2"},"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"attributes":{"id":"igxa2k"},"components":[{"type":"textnode","content":"Outcomes & learning"}]},{"tagName":"p","type":"text","classes":["project-showcase-value","project-customizable"],"attributes":{"id":"ibsnkm-2-2-2","role":"textbox","aria-multiline":"true","aria-label":"Project 01 outcomes","data-field":"project-more"},"components":[{"type":"textnode","content":"I’ve discovered a massive variation in the sensory output of objects across a wide range of area. The most notable outcome of my research was discovered while documenting trends in the taste and texture of objects across space. Objects found in the same location, within a variable area depending on location type, tend to have similarities with each other. Ex: Items that I’ve found in the ‘kitchen’ all seem to taste pleasant, while objects found in the grass tend to have adverse effects when consumed.  "}]}]}]}]},{"tagName":"article","name":"Third Project Card","classes":["gjs-t-border","project-showcase-card"],"attributes":{"data-js":"project-card","data-project":"03","aria-label":"Project 03"},"components":[{"name":"Project Image Panel","classes":["project-showcase-media"],"attributes":{"id":"iwxnfa"},"components":[{"name":"Project Image Placeholder","classes":["project-image-slot"],"attributes":{"id":"ifcj4j"},"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 03 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/60f32db9-2905-43dc-bca8-5a26c1636699__screenshot-2026-10-27-at-18-06-12-img5844.jpg-jpeg-image-689-919-pixels.png","id":"i9sihw"}}]},{"name":"Project Image Placeholder","classes":["project-image-slot"],"attributes":{"id":"ifcj4j-2"},"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 03 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/f50ac17c-4c9b-44bd-880a-edc0820b1c20__screenshot-2026-10-27-at-18-07-51-photo-google-photos.png","id":"i2rokj"}}]},{"name":"Project Image Placeholder","classes":["project-image-slot"],"attributes":{"id":"ifcj4j-2-2"},"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 03 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/78dd818a-b47d-4799-84d0-dfd35a05bfb3__screenshot-2026-10-27-at-18-04-26-photo-google-photos.png","id":"iroexg"}}]}]},{"name":"Project Details","classes":["project-showcase-content"],"attributes":{"id":"inv7cy"},"components":[{"tagName":"h3","type":"heading","name":"Editable Project Title","classes":["project-showcase-title","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 03 title","data-field":"project-03-name","id":"ifcibi"},"components":[{"type":"textnode","content":"The Me Outside of Work"}]},{"tagName":"p","type":"text","name":"Editable Detailed Description","classes":["project-showcase-description","project-customizable"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Project 03 detailed description","data-field":"project-03-description","id":"imqin47"},"components":[{"type":"textnode","content":"Despite my dedication to my craft. I can be a fun loving trouble maker outside of work!\n                "}]},{"attributes":{"id":"icxlbk"},"components":[{"tagName":"br","void":true,"attributes":{"id":"ih8aqg"}}]},{"type":"text","attributes":{"id":"isfery"},"components":[{"type":"textnode","content":"I often enjoy doing crafts with my moms, acrobatics, and playing tag! "}]},{"tagName":"p"}]}]}]},{"type":"script","name":"Project Image Upload Behavior","attributes":{"data-scope":"project-showcase","id":"igebbo-2"},"components":[{"type":"textnode","content":"\n            (() => {\n              const root = document.querySelector('[data-js=\"project-showcase\"]');\n              if (!root) return;\n              root.querySelectorAll('[data-js=\"project-card\"]').forEach(card => {\n                card.querySelectorAll('[data-js=\"upload\"]').forEach(input => {\n                  const group = input.closest('[data-js=\"image-upload-group\"]') || card;\n                  const preview = group.querySelector('[data-js=\"preview\"]');\n                  const status = group.querySelector('[data-js=\"image-status\"]');\n                  if (!preview || !status) return;\n                  const key = 'personal-project-image-' + (group.dataset.imageKey || card.dataset.project);\n                  const show = image => {\n                    preview.src = image;\n                    preview.hidden = false;\n                    group.querySelectorAll('[data-js=\"placeholder\"]').forEach(item => item.hidden = true);\n                  };\n                  try {\n                    const previous = localStorage.getItem(key);\n                    if (previous) show(previous);\n                  } catch (error) {}\n                  input.addEventListener('change', () => {\n                    const file = input.files[0];\n                    if (!file) return;\n                    if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 3 * 1024 * 1024) {\n                      status.textContent = 'Choose a JPEG, PNG, or WebP image up to 3 MB.';\n                      input.value = '';\n                      return;\n                    }\n                    const reader = new FileReader();\n                    reader.onerror = () => status.textContent = 'Unable to read this image. Please try another file.';\n                    reader.onload = () => {\n                      show(reader.result);\n                      try {\n                        localStorage.setItem(key, reader.result);\n                        status.textContent = 'Image saved in this browser.';\n                      } catch (error) {\n                        status.textContent = 'Image added, but browser storage is full or unavailable. Print to keep a copy.';\n                      }\n                      input.value = '';\n                    };\n                    reader.readAsDataURL(file);\n                  });\n                });\n              });\n            })();\n          "}]}]},{"tagName":"section","name":"Project Context Section","classes":["project-story-section"],"attributes":{"aria-labelledby":"project-context-heading","id":"i6hr4g-3","hidden":true}},{"tagName":"section","name":"Explore Portfolio","classes":["project-next-step","gjs-t-border"],"components":[{"tagName":"p","type":"text","name":"Explore Eyebrow","classes":["project-story-label"],"components":[{"type":"textnode","content":"Keep exploring"}]},{"tagName":"h2","type":"heading","name":"Explore Heading","classes":["gjs-t-h2"],"components":[{"type":"textnode","content":"Get to know the person behind the projects."}]},{"name":"Portfolio Links","classes":["project-page-actions"],"components":[{"type":"link","name":"About Me Link","classes":["gjs-t-button","project-page-button"],"attributes":{"href":"./more-about-me.html","id":"ikzwm2-2"},"components":[{"type":"textnode","content":"More about my mom"}]},{"type":"link","name":"CV Link","classes":["gjs-t-link","project-return-link"],"attributes":{"href":"./index.html","id":"i91ir2-2"},"components":[{"type":"textnode","content":" View my mom’s CV →"}]}]}]},{"tagName":"footer","classes":["document-footer"],"attributes":{"id":"page-footer-2-2"},"components":[{"tagName":"span","type":"text","attributes":{"id":"i25lqg-2-2"},"components":[{"type":"textnode","content":"A work in progress. Always learning."}]},{"type":"link","classes":["gjs-t-link","back-to-top-link"],"attributes":{"id":"i4wj8f-2-2","href":"#cv"},"components":[{"type":"textnode","content":"Back to top ↑"}]}]}]}],"locked":false}],"doctype":"<!DOCTYPE html>","head":{"type":"head","name":"Document Head","components":[{"tagName":"title","type":"text","attributes":{"id":"i93c3-3"},"components":[{"type":"textnode","content":"More About Madie's Research"}]},{"tagName":"meta","void":true,"attributes":{"charset":"UTF-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1.0"}},{"tagName":"meta","void":true,"attributes":{"name":"robots","content":"index,follow"}},{"tagName":"meta","void":true,"attributes":{"name":"generator","content":"GrapesJS Studio"}},{"tagName":"meta","void":true,"attributes":{"name":"description","content":"An expansion of some of my research and projects.","id":"i1ds2-3"}},{"tagName":"meta","void":true,"attributes":{"property":"og:title","content":"More About Madie's Research"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.googleapis.com"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","name":"CV Website","attributes":{"lang":"en"}}},"id":"S0xxChfzS6eaXOwK","minHeight":"500px"}],"id":"eWlS6T71pFt8NCNzyod"}],"symbols":[],"custom":{"projectType":"web","id":""}}