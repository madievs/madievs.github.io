me":"br","void":true}]},{"type":"text","attributes":{"id":"i21mdv"},"components":[{"type":"textnode","content":"Advisor: Dr. Doerte Blume"}]},{"tagName":"p"},{"tagName":"ul","name":"Research Achievements","classes":["research-achievements"],"attributes":{"id":"i5al7o"},"components":[{"tagName":"li","type":"text","name":"Editable Research Achievement","classes":["editable-research-achievement"],"attributes":{"data-field":"research-question","aria-label":"Research question","id":"i005l7g"},"components":[{"type":"textnode","content":"Reviewed and synthesized literature focusing on two level systems and Lewis-Riesenfeld invariant theory."}]},{"tagName":"li","type":"text","name":"Editable Research Achievement","classes":["editable-research-achievement"],"attributes":{"data-field":"research-methods","aria-label":"Research methods","id":"ils17pn"},"components":[{"type":"textnode","content":"Recreated numerical models using python, tracking dynamics, Lindblad operators, and entanglement generation. "}]},{"tagName":"li","type":"text","name":"Editable Research Achievement","classes":["editable-research-achievement"],"attributes":{"data-field":"research-outcomes","aria-label":"Research outcomes","id":"i1ao8hs"},"components":[{"type":"textnode","content":"Optimized script to refine driving protocols, attempting to improve the speed beyond literature baselines. "}]},{"tagName":"li","type":"text","name":"Editable Research Achievement","classes":["editable-research-achievement"],"attributes":{"data-field":"research-outcomes","aria-label":"Research outcomes","id":"i1ao8hs-2"},"components":[{"type":"textnode","content":"Presented weekly progress updates to research group, as well as a final summary and explanation of my summer research to the Physics REU program members. "}]}]}]}]},{"tagName":"section","name":"Work Experience Section","classes":["work-experience-section"],"attributes":{"id":"ihuscf"},"components":[{"name":"Section Heading Row","classes":["section-heading-row"],"components":[{"tagName":"span","type":"text","name":"Section Number","classes":["section-number"],"components":[{"type":"textnode","content":"03"}]},{"tagName":"h2","type":"heading","name":"Work Heading","classes":["gjs-t-h2","work-heading"],"components":[{"type":"textnode","content":"Work experience"}]},{"type":"image","name":"Work Icon","resizable":{"ratioDefault":1},"classes":["work-icon"],"attributes":{"src":"https://api.iconify.design/lucide-briefcase-business.svg?color=%2385977b","alt":"","width":"21","height":"21"}}]},{"tagName":"article","name":"Work Entry","classes":["work-entry"],"attributes":{"id":"i9oxx5"},"components":[{"name":"Entry Title Row","classes":["entry-title-row"],"attributes":{"id":"ip3hmh"},"components":[{"tagName":"h3","type":"heading","name":"Editable Job Title","classes":["editable-job-title"],"attributes":{"data-field":"job","aria-label":"Job title","id":"ikc2oh"},"components":[{"type":"textnode","content":"Headwait"}]},{"tagName":"span","type":"text","name":"Editable Dates","classes":["editable-dates"],"attributes":{"data-field":"job-dates","aria-label":"Employment dates","id":"inrzig"},"components":[{"type":"textnode","content":"2024 - Present"}]}]},{"tagName":"p","type":"text","name":"Editable Employer","classes":["editable-employer"],"attributes":{"data-field":"employer","aria-label":"Employer","id":"iwjk4g"},"components":[{"type":"textnode","content":"Outback Steakhouse · Norman, Oklahoma"}]},{"tagName":"p","type":"text","name":"Editable Work Description","classes":["editable-work-description"],"attributes":{"data-field":"job-details","aria-label":"Work achievements","id":"iufydf"},"components":[{"type":"textnode","content":"explain money management, find descriptions for what I actually do. Basically in charge of paying people and "}]}]}]},{"tagName":"article","name":"Work Entry","classes":["work-entry"],"attributes":{"id":"i7f7hk"},"components":[{"name":"Entry Title Row","classes":["entry-title-row"],"attributes":{"id":"i1pdqj"},"components":[{"tagName":"h3","type":"heading","name":"Editable Job Title","classes":["editable-job-title"],"attributes":{"data-field":"job","aria-label":"Job title","id":"iv1umf"},"components":[{"type":"textnode","content":"Server"}]},{"tagName":"span","type":"text","name":"Editable Dates","classes":["editable-dates"],"attributes":{"data-field":"job-dates","aria-label":"Employment dates","id":"i2srmb"},"components":[{"type":"textnode","content":"2024 - Present"}]}]},{"tagName":"p","type":"text","name":"Editable Employer","classes":["editable-employer"],"attributes":{"data-field":"employer","aria-label":"Employer","id":"imykng"},"components":[{"type":"textnode","content":"Outback Steakhouse · Norman, Oklahoma"}]},{"tagName":"p","type":"text","name":"Editable Work Description","classes":["editable-work-description"],"attributes":{"data-field":"job-details","aria-label":"Work achievements","id":"iu8eie"},"components":[{"type":"textnode","content":"not really super relevant so i hesitate to include it, however i dont want to seem unemployed "}]}]},{"tagName":"section","name":"Selected Projects Section","classes":["selected-projects-section"],"attributes":{"id":"selected-projects"},"components":[{"name":"Section Heading Row","classes":["section-heading-row"],"attributes":{"id":"iqja3i"},"components":[{"tagName":"span","type":"text","name":"Section Number","classes":["section-number"],"components":[{"type":"textnode","content":"04"}]},{"tagName":"h2","type":"heading","name":"Projects Heading","classes":["gjs-t-h2","projects-heading"],"attributes":{"id":"ivoubd"},"components":[{"type":"textnode","content":"Projects"}]},{"type":"image","name":"Projects Icon","resizable":{"ratioDefault":1},"classes":["projects-icon"],"attributes":{"src":"https://api.iconify.design/lucide-folder-open.svg?color=%2385977b","alt":"","width":"21","height":"21"}}]},{"tagName":"article","name":"Featured Project Card","classes":["gjs-t-border","featured-project-card"],"attributes":{"id":"ib0ybl"},"components":[{"tagName":"h3","type":"heading","name":"Editable Project Title","classes":["editable-project-title"],"attributes":{"data-field":"project-name","aria-label":"Project title","id":"ijtook"},"components":[{"type":"textnode","content":"This Website!"}]},{"tagName":"p","type":"text","name":"Editable Project Description","classes":["editable-project-description"],"attributes":{"data-field":"project-description","aria-label":"Project description","id":"inzrrx"},"components":[{"type":"textnode","content":"what did i learn"}]},{"tagName":"p","type":"text","name":"Editable Project Tools","classes":["editable-project-tools"],"attributes":{"data-field":"project-tools","aria-label":"Project tools","id":"i26jbo"},"components":[{"type":"textnode","content":"what tools/methods/tech did I use"}]}]}]},{"tagName":"section","name":"Skills and Recognition Section","classes":["skills-and-recognition-section"],"components":[{"name":"Section Heading Row","classes":["section-heading-row"],"attributes":{"id":"ieyxem"},"components":[{"tagName":"span","type":"text","name":"Section Number","classes":["section-number"],"components":[{"type":"textnode","content":"05"}]},{"tagName":"h2","type":"heading","name":"Skills Heading","classes":["gjs-t-h2","skills-heading"],"attributes":{"id":"i9pp5v"},"components":[{"type":"textnode","content":"Skills"}]},{"type":"image","name":"Recognition Icon","resizable":{"ratioDefault":1},"classes":["recognition-icon"],"attributes":{"src":"https://api.iconify.design/lucide-award.svg?color=%2385977b","alt":"","width":"21","height":"21"}}]},{"name":"Skills and Awards Columns","classes":["skills-and-awards-columns"],"components":[{"name":"Skills Group","classes":["skills-group"],"components":[{"tagName":"h3","type":"heading","name":"Skills Subheading","classes":["skills-subheading"],"components":[{"type":"textnode","content":"Tools & capabilities"}]},{"tagName":"p","type":"text","name":"Editable Skills","classes":["editable-skills"],"attributes":{"data-field":"skills","aria-label":"Skills","id":"i7e7za"},"components":[{"type":"textnode","content":"Python, Java, Github, think of more and how to list them"}]}]},{"name":"Awards Group","classes":["awards-group"],"attributes":{"id":"ib4f3a"}}]}]},{"tagName":"footer","name":"Document Footer","classes":["document-footer"],"components":[{"tagName":"span","type":"text","name":"Footer Statement","components":[{"type":"textnode","content":"A work in progress. Always learning."}]},{"type":"link","name":"Back to Top Link","classes":["gjs-t-link","back-to-top-link"],"attributes":{"href":"#cv-start"},"components":[{"type":"textnode","content":"Back to top ↑"}]}]}]}]},{"type":"script","name":"CV Editing and Print Functionality","attributes":{"id":"izo7yk"},"components":[{"type":"textnode","content":"\n      (() => {\n        const root = document.currentScript.parentElement;\n        root.setAttribute('data-js', 'cv-page');\n        const scope = document.querySelector('[data-js=\"cv-page\"]');\n        const bind = (selector, name) => {\n          const elements = [...scope.querySelectorAll(selector)];\n          elements.forEach(element => element.setAttribute('data-js', name));\n          return elements;\n        };\n        bind('[data-field]', 'cv-field');\n        bind('[data-status]', 'cv-status');\n        bind('[data-photo]', 'cv-photo');\n        bind('[data-photo-input]', 'cv-photo-input');\n        bind('[data-menu]', 'cv-menu');\n        bind('[data-print]', 'cv-print');\n        const fields = [...scope.querySelectorAll('[data-js=\"cv-field\"]')];\n        const status = scope.querySelector('[data-js=\"cv-status\"]');\n        const photo = scope.querySelector('[data-js=\"cv-photo\"]');\n        const menu = scope.querySelector('[data-js=\"cv-menu\"]');\n        const storageKey = 'personal-cv-content-v3';\n        let timer;\n        fields.forEach(field => {\n          field.contentEditable = 'true';\n          field.classList.add('cv-editable');\n          field.setAttribute('tabindex', '0');\n        });\n        try {\n          const saved = JSON.parse(localStorage.getItem(storageKey) || '{}');\n          fields.forEach(field => {\n            if (typeof saved?.[field.dataset.field] === 'string') field.textContent = saved[field.dataset.field];\n          });\n          const savedPhoto = localStorage.getItem(storageKey + '-photo');\n          if (savedPhoto) {\n            photo.src = savedPhoto;\n            photo.alt = 'Personal profile photo';\n            photo.classList.add('profile-photo-custom');\n          }\n        } catch {\n          status.textContent = 'Local saving is unavailable. Print to keep a copy.';\n        }\n\n        function save() {\n          try {\n            localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(fields.map(field => [field.dataset.field, field.textContent]))));\n            status.textContent = 'Saved on this device. Print or save as PDF to share.';\n          } catch {\n            status.textContent = 'Unable to save locally. Print to keep a copy.';\n          }\n        }\n        fields.forEach(field => {\n          field.addEventListener('input', () => {\n            status.textContent = 'Saving your changes…';\n            clearTimeout(timer);\n            timer = setTimeout(save, 350);\n          });\n          field.addEventListener('blur', () => {\n            clearTimeout(timer);\n            save();\n          });\n          field.addEventListener('paste', event => {\n            event.preventDefault();\n            const selection = window.getSelection();\n            if (!selection || !selection.rangeCount) return;\n            const range = selection.getRangeAt(0);\n            if (!field.contains(range.commonAncestorContainer)) return;\n            range.deleteContents();\n            const text = document.createTextNode(event.clipboardData.getData('text/plain'));\n            range.insertNode(text);\n            range.setStartAfter(text);\n            range.collapse(true);\n            selection.removeAllRanges();\n            selection.addRange(range);\n            field.dispatchEvent(new Event('input'));\n          });\n        });\n        scope.querySelector('[data-js=\"cv-photo-input\"]').addEventListener('change', event => {\n          const file = event.target.files[0];\n          if (!file) return;\n          if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 3 * 1024 * 1024) {\n            status.textContent = 'Choose a JPEG, PNG, or WebP photo smaller than 3 MB.';\n            event.target.value = '';\n            return;\n          }\n          const reader = new FileReader();\n          reader.onerror = () => {\n            status.textContent = 'Unable to read this photo. Please try another image.';\n          };\n          reader.onload = () => {\n            photo.src = reader.result;\n            photo.alt = 'Personal profile photo';\n            photo.classList.add('profile-photo-custom');\n            try {\n              localStorage.setItem(storageKey + '-photo', reader.result);\n              status.textContent = 'Photo saved on this device.';\n            } catch {\n              status.textContent = 'Photo added but could not be saved locally.';\n            }\n          };\n          reader.readAsDataURL(file);\n        });\n        bind('.explore-dropdown-menu a', 'cv-menu-link');\n        scope.querySelectorAll('[data-js=\"cv-menu-link\"]').forEach(link => link.addEventListener('click', () => menu.open = false));\n        document.addEventListener('click', event => {\n          if (!menu.contains(event.target)) menu.open = false;\n        });\n        document.addEventListener('keydown', event => {\n          if (event.key === 'Escape') {\n            menu.open = false;\n            bind('.explore-dropdown-toggle', 'cv-menu-toggle')[0].focus();\n          }\n        });\n        const printGroups = [\n          ['.site-header, .editing-instructions, .upload-photo-label, .print-actions, .document-footer, .read-more-about-me', 'cv-print-hidden'],\n          ['.two-column-cv-layout', 'cv-print-layout'],\n          ['.fixed-personal-profile', 'cv-print-profile'],\n          ['.profile-content', 'cv-print-profile-content'],\n          ['.profile-eyebrow, .editable-professional-title, .contact-heading, .personal-statement-heading, .editable-personal-statement', 'cv-print-text'],\n          ['.education-section, .research-experience-section, .work-experience-section, .selected-projects-section, .skills-and-recognition-section', 'cv-print-section'],\n          ['.cv-title', 'cv-print-heading'],\n          ['.entry-title-row', 'cv-print-row'],\n          ['.contact-information', 'cv-print-contact'],\n          ['.cv-editable', 'cv-print-editable']\n        ].map(([selector, className], index) => {\n          const name = 'cv-print-group-' + index;\n          bind(selector, name);\n          return {\n            name,\n            className\n          };\n        });\n        bind('[data-project-details]', 'cv-project-details');\n        let detailStates = [];\n        let printing = false;\n\n        function preparePrint() {\n          if (printing) return;\n          printing = true;\n          document.activeElement?.blur();\n          clearTimeout(timer);\n          save();\n          scope.classList.add('cv-print-page');\n          printGroups.forEach(({\n            name,\n            className\n          }) => {\n            scope.querySelectorAll('[data-js=\"' + name + '\"]').forEach(element => element.classList.add(className));\n          });\n          detailStates = [...scope.querySelectorAll('[data-js=\"cv-project-details\"]')].map(element => ({\n            element,\n            open: element.open\n          }));\n          detailStates.forEach(({\n            element\n          }) => element.open = true);\n        }\n\n        function restorePrint() {\n          scope.classList.remove('cv-print-page');\n          printGroups.forEach(({\n            name,\n            className\n          }) => {\n            scope.querySelectorAll('[data-js=\"' + name + '\"]').forEach(element => element.classList.remove(className));\n          });\n          detailStates.forEach(({\n            element,\n            open\n          }) => element.open = open);\n          printing = false;\n        }\n        window.addEventListener('beforeprint', preparePrint);\n        window.addEventListener('afterprint', restorePrint);\n        scope.querySelector('[data-js=\"cv-print\"]').addEventListener('click', () => {\n          preparePrint();\n          try {\n            window.print();\n          } finally {\n            restorePrint();\n          }\n        });\n      })();\n    "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","name":"Page Head","components":[{"tagName":"title","type":"text","components":[{"type":"textnode","content":"Madie's Website Home"}]},{"tagName":"meta","void":true,"attributes":{"charset":"UTF-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1.0"}},{"tagName":"meta","void":true,"attributes":{"name":"robots","content":"index,follow"}},{"tagName":"meta","void":true,"attributes":{"name":"generator","content":"GrapesJS Studio"}},{"tagName":"meta","void":true,"attributes":{"name":"description","content":"My personal curriculum vitae and research portfolio"}},{"tagName":"meta","void":true,"attributes":{"property":"og:title","content":"Madie's Super Ultra Mega Fun Website [Working Title]"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.googleapis.com"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap","rel":"stylesheet"}}]},"docEl":{"tagN