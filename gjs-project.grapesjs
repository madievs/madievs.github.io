e-about-me-link"],"attributes":{"href":"##","id":"ickuv"},"components":[{"type":"textnode","content":"More About Me"}]},{"type":"link","classes":["gjs-t-link","more-about-my-projects-link"],"attributes":{"href":"./cv.html","aria-current":"page","id":"i52mq"},"components":[{"type":"textnode","content":"More About My Projects"}],"hrefType":"pages"}]}]}]}]}]},{"tagName":"main","name":"Two Column CV Layout","classes":["two-column-cv-layout"],"attributes":{"id":"cv-2"},"components":[{"tagName":"aside","name":"Fixed Profile Panel","classes":["fixed-profile-panel"],"attributes":{"id":"profile-panel-2","aria-label":"Personal profile"},"components":[{"name":"Profile Content","classes":["profile-content"],"attributes":{"id":"irj7rg"},"components":[{"name":"Profile Photo Area","classes":["profile-photo-area"],"attributes":{"id":"ijwvnk"},"components":[{"name":"Profile Photo Frame","classes":["profile-photo-frame"],"attributes":{"id":"iqdx55"},"components":[{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/074a34b6-3297-46db-94d3-89b7f71458b8__screenshot-2026-10-27-at-16-17-19-photo-google-photos.png","id":"i06cmjl"}}]}]},{"name":"Name and Profession","classes":["name-and-profession"],"components":[{"type":"heading","name":"Editable Name","classes":["editable-name"],"attributes":{"role":"textbox","aria-label":"Your name","data-field":"name","spellcheck":"false","id":"icj7zw"},"components":[{"type":"textnode","content":"Madeline van Staveren"}]}]},{"name":"Contact Information","classes":["contact-information"],"attributes":{"id":"ioecji"},"components":[{"tagName":"h2","type":"heading","name":"Contact Heading","classes":["contact-heading"],"components":[{"type":"textnode","content":"Let's connect"}]},{"name":"Email Contact","classes":["email-contact"],"attributes":{"id":"imjncx"},"components":[{"type":"image","name":"Email Icon","resizable":{"ratioDefault":1},"classes":["email-icon"],"attributes":{"src":"https://api.iconify.design/lucide-mail.svg?color=%23cbe2b5","width":"16","height":"16","alt":""}},{"tagName":"span","type":"text","name":"Editable Email","classes":["editable-email"],"attributes":{"role":"textbox","aria-label":"Email address","data-field":"email","id":"ifdzlm"},"components":[{"type":"textnode","content":"insert new gmail for this only"}]}]},{"name":"Location Contact","classes":["location-contact"],"components":[{"type":"image","name":"Location Icon","resizable":{"ratioDefault":1},"classes":["location-icon"],"attributes":{"src":"https://static.vecteezy.com/system/resources/previews/044/267/763/non_2x/outline-drawing-of-oklahoma-state-map-free-png.png","width":"16","height":"16","alt":"","id":"it7tl-2"}},{"tagName":"span","type":"text","name":"Editable Location","classes":["editable-location"],"attributes":{"role":"textbox","aria-label":"Your location","data-field":"location","id":"i0lda7"},"components":[{"type":"textnode","content":"[Norman, Oklahoma]"}]}]},{"name":"Website Contact","classes":["website-contact"],"components":[{"type":"image","name":"Website Icon","resizable":{"ratioDefault":1},"classes":["website-icon"],"attributes":{"src":"https://www.vikingcamps.com/wp-content/uploads/2024/01/linkedin-logo-linkedin-icon-transparent-free-png.webp","width":"16","height":"16","alt":"","id":"iukyr-3"}},{"tagName":"span","type":"text","name":"Editable Website","classes":["editable-website"],"attributes":{"role":"textbox","aria-label":"Your website or LinkedIn URL","data-field":"website","id":"iiho3h"},"components":[{"type":"textnode","content":"www.linkedin.com/in/madie-v"}]}]}]},{"name":"Personal Statement","classes":["personal-statement"],"components":[{"tagName":"h2","type":"heading","name":"Personal Statement Heading","classes":["personal-statement-heading"],"components":[{"type":"textnode","content":"What drives me"}]},{"tagName":"p","type":"text","name":"Editable Personal Statement","classes":["editable-personal-statement"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Personal statement","data-field":"statement","id":"izgoowd"},"components":[{"type":"textnode","content":"Insert personal statement about passions in physics and astronomy, including some career goals."}]}]},{"name":"Print CV Actions","classes":["editor-control","print-cv-actions"]}]}]},{"name":"CV Document Column","classes":["cv-document-column"],"attributes":{"id":"isigh-2"},"components":[{"classes":["cv-introduction"],"attributes":{"id":"id0fg"},"components":[{"tagName":"h2","type":"heading","classes":["gjs-t-h1","cv-page-heading"],"attributes":{"id":"iyagy"},"components":[{"type":"textnode","content":"More about ME"},{"tagName":"span","type":"text","classes":["heading-accent"],"attributes":{"id":"iy4yj"},"components":[{"type":"textnode","content":" (temp title)."}]}]}]},{"classes":["editor-control","projects-editing-note"],"attributes":{"id":"irrcw"},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["editing-icon"],"attributes":{"id":"ijtnn","src":"https://api.iconify.design/lucide-pencil-line.svg?color=%235b7154","width":"17","height":"17","alt":""}},{"classes":["editing-help"],"attributes":{"id":"ityai"},"components":[{"tagName":"p","type":"text","classes":["editing-tip"],"attributes":{"id":"ionuh"},"components":[{"type":"textnode","content":"insert small little into sentence to segue into why anyone would car about this and what this is"}]}]}]},{"tagName":"section","classes":["more-about-my-projects-section"],"attributes":{"id":"projects","aria-labelledby":"projects-heading","data-js":"project-showcase"},"components":[{"name":"Three Project Showcase","classes":["project-showcase-list"],"attributes":{"id":"igshu2"},"components":[{"tagName":"article","classes":["gjs-t-border","project-showcase-card"],"attributes":{"id":"isq3n4","aria-labelledby":"i9olr4","data-js":"project-card","data-project":"01"},"components":[{"name":"Project Image Panel","classes":["project-showcase-media"],"attr