d":"irrcw-2"},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["editing-icon"],"attributes":{"id":"ijtnn-2","src":"https://api.iconify.design/lucide-pencil-line.svg?color=%235b7154","width":"17","height":"17","alt":""}},{"classes":["editing-help"],"attributes":{"id":"ityai-2"},"components":[{"tagName":"p","type":"text","classes":["editing-tip"],"attributes":{"id":"ionuh-2"},"components":[{"type":"textnode","content":"Maybe a little summary or intro sentance about this page! "}]}]}]},{"tagName":"section","classes":["more-about-my-projects-section"],"attributes":{"id":"projects-2","aria-labelledby":"projects-heading","data-js":"project-showcase"},"components":[{"classes":["section-heading-row"],"attributes":{"id":"i4u991-2"},"components":[{"tagName":"span","type":"text","classes":["section-number"],"attributes":{"id":"iti48y-2"},"components":[{"type":"textnode","content":"01—03"}]},{"tagName":"h2","type":"heading","classes":["gjs-t-h2","projects-heading"],"attributes":{"id":"projects-heading-2"},"components":[{"type":"textnode","content":"Selected projects"}]},{"type":"image","resizable":{"ratioDefault":1},"classes":["projects-icon"],"attributes":{"id":"ieu36i-2","src":"https://api.iconify.design/lucide-folder-open.svg?color=%2385977b","width":"21","height":"21","alt":""}}]},{"name":"Three Project Showcase","classes":["project-showcase-list"],"attributes":{"id":"ixt1o7"},"components":[{"tagName":"article","classes":["gjs-t-border","project-showcase-card"],"attributes":{"id":"isq3n4-2","aria-labelledby":"i9olr4","data-js":"project-card","data-project":"01"},"components":[{"name":"Project Image Panel","classes":["project-showcase-media"],"attributes":{"id":"ity1ph"},"components":[{"name":"Project Image Placeholder","classes":["project-image-slot"],"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 01 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","name":"Image Placeholder Icon","resizable":{"ratioDefault":1},"attributes":{"src":"https://api.iconify.design/lucide-image.svg?color=%23517269","width":"32","height":"32","alt":""}},{"tagName":"span","type":"text","name":"Image Placeholder Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Project 01 image"}]},{"tagName":"p","type":"text","name":"Image Guidance","classes":["project-image-hint"],"components":[{"type":"textnode","content":"Add a photograph, research figure, or screenshot of your work."}]}]},{"type":"label","name":"Upload Project Image","classes":["project-image-upload","editor-control"],"attributes":{"id":"ibicyk"},"components":[{"type":"textnode","content":"Add or replace image\n                  "},{"type":"input","name":"Project Image File Input","void":true,"classes":["project-image-input"],"attributes":{"type":"file","accept":"image/jpeg,image/png,image/webp","data-js":"upload","aria-label":"Choose an image for project 01"}}]},{"tagName":"p","type":"text","name":"Image Upload Status","classes":["project-image-status","editor-control"],"attributes":{"data-js":"image-status","aria-live":"polite","id":"icc816"},"components":[{"type":"textnode","content":"JPEG, PNG, or WebP · up to 3 MB"}]}]},{"name":"Project Details","classes":["project-showcase-content"],"attributes":{"id":"iy7xwv"},"components":[{"tagName":"h3","type":"heading","classes":["project-showcase-title","project-customizable"],"attributes":{"id":"i9olr4-2","role":"textbox","aria-label":"Project 01 title","data-field":"project-name"},"components":[{"type":"textnode","content":"Research Experience for Undergraduates: Galactic Archaeology and the Formation of Elements"}]},{"tagName":"p","type":"text","classes":["project-showcase-description","project-customizable"],"attributes":{"id":"ie43b5-2","role":"textbox","aria-multiline":"true","aria-label":"Project 01 detailed description","data-field":"project-description"},"components":[{"type":"textnode","content":"Not only was this my summer research project but it was part of my capstone (? make separate??) Spent a couple months reading and rereading beginning literature on galactic archaeology, taking notes and trying to understand the relevant stellar processes. Was given a prewritten galactic chemical evolution model code by one of Dr. Michael Hayden’s earlier postdocs and reviewed it to understand the notation and how the gce model was written and how it functioned. Part of this process was me learning how to work github, as well as have multiple local files for this and access them from remote locations. This took up most of the time thus far tbh it was very dense. I then began to isolate the Barium production in varying degrees based on metallicity and mass of agb stars to emperically find yields that better fit observational data. I spent time writing up not only these findings but a methods section of a paper for how the model worked. hope to finalize the paper by next year and submit for publication"}]},{"name":"Project Role","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"attributes":{"id":"izv53j"},"components":[{"type":"textnode","content":"collaborators"}]},{"tagName":"p","type":"text","name":"Editable Project Role","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 01 role","data-field":"project-01-role","id":"i1lm0q"},"components":[{"type":"textnode","content":"Dr. Michael Hayden"}]}]},{"name":"Project Methods","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","classes":["project-story-label"],"attributes":{"id":"iovndo-2"},"components":[{"type":"textnode","content":"Tools & methods"}]},{"tagName":"p","type":"text","classes":["project-showcase-value","project-customizable"],"attributes":{"id":"ii8dk6-2","role":"textbox","aria-label":"Project 01 tools and methods","data-field":"project-tools"},"components":[{"type":"textnode","content":"GIthub, LaTex, Python"}]}]},{"name":"Project Outcomes","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Outcomes & learning"}]},{"tagName":"p","type":"text","classes":["project-showcase-value","project-customizable"],"attributes":{"id":"ibsnkm-2","role":"textbox","aria-multiline":"true","aria-label":"Project 01 outcomes","data-field":"project-more"},"components":[{"type":"textnode","content":"Description"}]}]}]}]},{"tagName":"article","name":"Second Project Card","classes":["gjs-t-border","project-showcase-card"],"attributes":{"data-js":"project-card","data-project":"02","aria-label":"Project 02","id":"iwiooa"},"components":[{"name":"Project Image Panel","classes":["project-showcase-media"],"attributes":{"id":"i6udia"},"components":[{"classes":["project-image-slot","project-image-fitted"],"attributes":{"id":"icw233","__nc":""},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 02 image","hidden":true,"src":"data:image/svg+xml;base64,","id":"icjlk4"}},{"type":"link","editable":false,"classes":["gjs-t-link","project-image-link"],"attributes":{"href":"https://drive.google.com/file/d/1557nEqFRBDnSWYs1X6rL2PKTRXO2pdDz/view?usp=sharing","target":"_blank","rel":"noopener noreferrer","aria-label":"Open the adiabatic shortcuts research document on Google Drive in a new tab","id":"izcuae"},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["project-research-image"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/e3c9e3e8-57a2-4d9d-bafe-77eb38154c72__screenshot-2026-10-27-at-15-23-45-adiabatic-shortcuts-in-closed-and-open-driven-two-level-systems-google-slides.png","id":"ipfl8h","alt":"Adiabatic shortcuts in closed and open driven two-level systems research presentation","loading":"lazy","__nc":""}}]}]},{"type":"label","name":"Research Image Notes","classes":["project-media-notes"],"attributes":{"id":"iweqa5"},"components":[{"tagName":"p","type":"text","name":"Presentation Image Caption","classes":["project-static-caption"],"attributes":{"id":"ijnu21"},"components":[{"type":"textnode","content":"Click the image to see my full presentation!"}]}]},{"name":"Additional Research Image One","classes":["project-extra-image"],"attributes":{"data-js":"image-upload-group","data-image-key":"02-extra-01","id":"iwffxq"},"components":[{"name":"Additional Image Preview","classes":["project-image-slot","project-compact-image-slot"],"attributes":{"id":"io62uo"},"components":[{"name":"Rounded Research Image Frame","classes":["project-image-slot","project-image-fitted"],"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["project-natural-image"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/05cb397d-ab6d-4062-9eeb-45675e76fe3a__screenshot-2026-10-27-at-15-32-13-adiabatic-shortcuts-in-closed-and-open-driven-two-level-systems-google-slides.png","id":"iov3qs","data-js":"placeholder","alt":"Adiabatic shortcuts research figure","loading":"lazy"}}]},{"tagName":"p","type":"text","classes":["project-static-caption"],"attributes":{"id":"ifph8k"},"components":[{"type":"textnode","content":"Examples from the presentation of how I was able to reverse engineer Lewis-Riesenfeld invariants to obtain the same endpoints as a system that evolved adiabatically."}]}]}]},{"name":"Additional Research Image Two","classes":["project-extra-image"],"attributes":{"data-js":"image-upload-group","data-image-key":"02-extra-02"},"components":[{"name":"Additional Image Preview","classes":["project-image-slot","project-compact-image-slot"],"attributes":{"id":"iq9ery"},"components":[{"name":"Rounded Research Image Frame","classes":["project-image-slot","project-image-fitted"],"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["project-natural-image"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/6a2a084f-be64-4515-bbfe-fad574aa8951__screenshot-2026-10-27-at-15-33-21-adiabatic-shortcuts-in-closed-and-open-driven-two-level-systems-google-slides.png","id":"ifdl8f","data-js":"placeholder","alt":"Adiabatic shortcuts research figure","loading":"lazy"}}]}]}]}]},{"name":"Project Details","classes":["project-showcase-content"],"attributes":{"id":"iut6x2"},"components":[{"tagName":"h3","type":"heading","name":"Editable Project Title","classes":["project-showcase-title","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 02 title","data-field":"project-02-name","id":"ia6kln"},"components":[{"type":"textnode","content":"Research Experience for Undergraduates: Adiabatic Shortcuts In Closed and Open Driven Two Level System"}]},{"tagName":"p","type":"text","name":"Editable Detailed Description","classes":["project-showcase-description","project-customizable"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Project 02 detailed description","data-field":"project-02-description","id":"iqr5nd"},"components":[{"type":"textnode","content":"Over the course of the summer (2024) I had the privilege of working under Dr. Doerte Blume and her research group. I worked closely with Dr. Sagarika Basak (post-doc at the time) who’s work was a more complex variation of my own summer research project. I read through assigned literature relevant to driven two level systems, lewis-riesenfeld invariants, and adiabatic shortcuts. The first half of my summer was spent understanding these pieces of literature and more importantly replicating some of the key results in them by coding in Python to better understand how these systems work. The latter half of my summer I delved into more complex research papers and attempting to create my own end goal for an adiabatic system and solving for a sufficient shortcut. Throughout the summer I presented at weekly meetings in the research group, assembling short presentations going over my progress and it opened the floor to a collaborative work environment that encouraged a better understanding. "}]},{"name":"Project Role","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"attributes":{"id":"ipi7z3"},"components":[{"type":"textnode","content":"collaborators"}]},{"tagName":"p","type":"text","name":"Editable Project Role","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 02 role","data-field":"project-02-role","id":"ioa3uy"},"components":[{"type":"textnode","content":"Dr. Doerte Blume, Dr. Sagarika Basak, Jacob find his last name. dude did help me a lot"}]}]},{"name":"Project Methods","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Tools & methods"}]},{"tagName":"p","type":"text","name":"Editable Project Methods","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 02 tools and methods","data-field":"project-02-tools","id":"iwcn2s"},"components":[{"type":"textnode","content":"Wrote my own python code based on equation in the literature to obtain the same resutls, weekly meetings, research notation"}]}]},{"name":"Project Outcomes","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Outcomes & learning"}]}]},{"tagName":"p","type":"text","name":"Editable Project Outcomes","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Project 02 outcomes","data-field":"project-02-outcomes","id":"ipbzm2"},"components":[{"type":"textnode","content":"Was a fantastic first research experience, helped me to feel more confident in my ability to actually conduct research, aided in presentation ablities, organization when it came to research and documentation of code changes. "}]}]}]},{"tagName":"article","name":"Third Project Card","classes":["gjs-t-border","project-showcase-card"],"attributes":{"data-js":"project-card","data-project":"03","aria-label":"Project 03"},"components":[{"name":"Project Image Panel","classes":["project-showcase-media"],"components":[{"name":"Project Image Placeholder","classes":["project-image-slot"],"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 03 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","name":"Image Placeholder Icon","resizable":{"ratioDefault":1},"attributes":{"src":"https://api.iconify.design/lucide-image.svg?color=%23517269","width":"32","height":"32","alt":"","loading":"lazy"}},{"tagName":"span","type":"text","name":"Image Placeholder Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Project 03 image"}]},{"tagName":"p","type":"text","name":"Image Guidance","classes":["project-image-hint"],"components":[{"type":"textnode","content":"Highlight an experiment, a final outcome, or work in progress."}]}]},{"type":"label","name":"Upload Project Image","classes":["project-image-upload","editor-control"],"components":[{"type":"textnode","content":"Add or replace image\n                  "},{"type":"input","name":"Project Image File Input","void":true,"classes":["project-image-input"],"attributes":{"type":"file","accept":"image/jpeg,image/png,image/webp","data-js":"upload","aria-label":"Choose an image for project 03"}}]},{"tagName":"p","type":"text","name":"Image Upload Status","classes":["project-image-status","editor-control"],"attributes":{"data-js":"image-status","aria-live":"polite"},"components":[{"type":"textnode","content":"JPEG, PNG, or WebP · up to 3 MB"}]}]},{"name":"Project Details","classes":["project-showcase-content"],"components":[{"tagName":"h3","type":"heading","name":"Editable Project Title","classes":["project-showcase-title","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 03 title","data-field":"project-03-name"},"components":[{"type":"textnode","content":"[Your third project name]"}]},{"tagName":"p","type":"text","name":"Editable Detailed Description","classes":["project-showcase-description","project-customizable"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Project 03 detailed description","data-field":"project-03-description","id":"io9kht"},"components":[{"type":"textnode","content":"Description of third project in a story line manner"}]},{"name":"Project Role","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"My role & collaborators"}]},{"tagName":"p","type":"text","name":"Editable Project Role","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 03 role","data-field":"project-03-role","id":"isxtkk"},"components":[{"type":"textnode","content":"Names"}]}]},{"name":"Project Methods","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Tools & methods"}]},{"tagName":"p","type":"text","name":"Editable Project Methods","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-label":"Project 03 tools and methods","data-field":"project-03-tools","id":"i1kp9x"},"components":[{"type":"textnode","content":"[The methods, equipment, software, or creative techniques used]"}]}]},{"name":"Project Outcomes","classes":["project-showcase-field"],"components":[{"tagName":"span","type":"text","name":"Detail Label","classes":["project-story-label"],"components":[{"type":"textnode","content":"Outcomes & next steps"}]},{"tagName":"p","type":"text","name":"Editable Project Outcomes","classes":["project-showcase-value","project-customizable"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Project 03 outcomes","data-field":"project-03-outcomes","id":"il6b9x"},"components":[{"type":"textnode","content":"little summary"}]}]}]}]}]},{"type":"script","name":"Project Image Upload Behavior","attributes":{"data-scope":"project-showcase","id":"igebbo"},"components":[{"type":"textnode","content":"\n            (() => {\n              const root = document.querySelector('[data-js=\"project-showcase\"]');\n              if (!root) return;\n              root.querySelectorAll('[data-js=\"project-card\"]').forEach(card => {\n                card.querySelectorAll('[data-js=\"upload\"]').forEach(input => {\n                  const group = input.closest('[data-js=\"image-upload-group\"]') || card;\n                  const preview = group.querySelector('[data-js=\"preview\"]');\n                  const status = group.querySelector('[data-js=\"image-status\"]');\n                  if (!preview || !status) return;\n                  const key = 'personal-project-image-' + (group.dataset.imageKey || card.dataset.project);\n                  const show = image => {\n                    preview.src = image;\n                    preview.hidden = false;\n                    group.querySelectorAll('[data-js=\"placeholder\"]').forEach(item => item.hidden = true);\n                  };\n                  try {\n                    const previous = localStorage.getItem(key);\n                    if (previous) show(previous);\n                  } catch (error) {}\n                  input.addEventListener('change', () => {\n                    const file = input.files[0];\n                    if (!file) return;\n                    if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 3 * 1024 * 1024) {\n                      status.textContent = 'Choose a JPEG, PNG, or WebP image up to 3 MB.';\n                      input.value = '';\n                      return;\n                    }\n                    const reader = new FileReader();\n                    reader.onerror = () => status.textContent = 'Unable to read this image. Please try another file.';\n                    reader.onload = () => {\n                      show(reader.result);\n                      try {\n                        localStorage.setItem(key, reader.result);\n                        status.textContent = 'Image saved in this browser.';\n                      } catch (error) {\n                        status.textContent = 'Image added, but browser storage is full or unavailable. Print to keep a copy.';\n                      }\n                      input.value = '';\n                    };\n                    reader.readAsDataURL(file);\n                  });\n                });\n              });\n            })();\n          "}]}]},{"tagName":"section","name":"Project Context Section","classes":["project-story-section"],"attributes":{"aria-labelledby":"project-context-heading","id":"i6hr4g","hidden":true}},{"tagName":"section","name":"Explore Portfolio","classes":["project-next-step","gjs-t-border"],"components":[{"tagName":"p","type":"text","name":"Explore Eyebrow","classes":["project-story-label"],"components":[{"type":"textnode","content":"Keep exploring"}]},{"tagName":"h2","type":"heading","name":"Explore Heading","classes":["gjs-t-h2"],"components":[{"type":"textnode","content":"Get to know the person behind the projects."}]},{"name":"Portfolio Links","classes":["project-page-actions"],"components":[{"type":"link","name":"About Me Link","classes":["gjs-t-button","project-page-button"],"attributes":{"href":"./more-about-me.html","id":"ikzwm2"},"components":[{"type":"textnode","content":"More about me"}]},{"type":"link","name":"CV Link","classes":["gjs-t-link","project-return-link"],"attributes":{"href":"./index.html","id":"i91ir2"},"components":[{"type":"textnode","content":"View my CV →"}]}]}]},{"tagName":"footer","classes":["document-footer"],"attributes":{"id":"page-footer-2"},"components":[{"tagName":"span","type":"text","attributes":{"id":"i25lqg-2"},"components":[{"type":"textnode","content":"A work in progress. Always learning."}]},{"type":"link","classes":["gjs-t-link","back-to-top-link"],"attributes":{"id":"i4wj8f-2","href":"#cv"},"components":[{"type":"textnode","content":"Back to top ↑"}]}]}]}]},{"type":"script","name":"CV Editing and Printing","components":[{"type":"textnode","content":"\n      (() => {\n        const storageKey = 'personal-cv-content-v1';\n        const fields = [...document.querySelectorAll('[data-field]')];\n        const status = document.getElementById('save-status');\n        let saved = {};\n        try {\n          saved = JSON.parse(localStorage.getItem(storageKey) || '{}');\n          fields.forEach(field => {\n            if (typeof saved[field.dataset.field] === 'string') field.textContent = saved[field.dataset.field];\n          });\n        } catch (error) {\n          status.textContent = 'Browser storage is unavailable. Print to keep a copy.';\n        }\n        let timer;\n        fields.forEach(field => {\n          field.addEventListener('input', () => {\n            status.textContent = 'Saving your changes…';\n            clearTimeout(timer);\n            timer = setTimeout(() => {\n              fields.forEach(item => saved[item.dataset.field] = item.textContent);\n              try {\n                localStorage.setItem(storageKey, JSON.stringify(saved));\n                status.textContent = 'Saved in this browser. Your changes stay on this device.';\n              } catch (error) {\n                status.textContent = 'Unable to save locally. Print to keep a copy.';\n              }\n            }, 400);\n          });\n          field.addEventListener('paste', event => {\n            event.preventDefault();\n            const text = event.clipboardData.getData('text/plain');\n            const selection = window.getSelection();\n            if (!selection.rangeCount) return;\n            const range = selection.getRangeAt(0);\n            range.deleteContents();\n            const node = document.createTextNode(text);\n            range.insertNode(node);\n            range.setStartAfter(node);\n            range.collapse(true);\n            selection.removeAllRanges();\n            selection.addRange(range);\n            field.dispatchEvent(new Event('input', {\n              bubbles: true\n            }));\n          });\n        });\n\n        const photo = document.getElementById('profile-photo');\n        try {\n          const previousPhoto = localStorage.getItem('personal-cv-photo-v1');\n          if (previousPhoto) {\n            photo.src = previousPhoto;\n            photo.classList.remove('p-5');\n            photo.alt = 'Personal profile photo';\n          }\n        } catch (error) {}\n        document.getElementById('photo-input').addEventListener('change', event => {\n          const file = event.target.files[0];\n          if (!file) return;\n          if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {\n            status.textContent = 'Please choose a JPEG, PNG, or WebP photo.';\n            return;\n          }\n          if (file.size > 3 * 1024 * 1024) {\n            status.textContent = 'Please choose a photo smaller than 3 MB.';\n            return;\n          }\n          const reader = new FileReader();\n          reader.onload = () => {\n            photo.src = reader.result;\n            photo.alt = 'Personal profile photo';\n            photo.classList.remove('p-5');\n            try {\n              localStorage.setItem('personal-cv-photo-v1', reader.result);\n              status.textContent = 'Photo saved in this browser.';\n            } catch (error) {\n              status.textContent = 'Photo added, but could not be saved locally.';\n            }\n          };\n          reader.readAsDataURL(file);\n        });\n\n        const menu = document.getElementById('more-menu');\n        menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => menu.open = false));\n        document.addEventListener('click', event => {\n          if (!menu.contains(event.target)) menu.open = false;\n        });\n        document.addEventListener('keydown', event => {\n          if (event.key === 'Escape') menu.open = false;\n        });\n\n        const panel = document.getElementById('profile-panel');\n        const hiddenForPrint = [\n          document.getElementById('site-header'),\n          document.getElementById('page-footer'),\n          ...document.querySelectorAll('.editor-control')\n        ];\n        let printing = false;\n        let previousDetails = [];\n        const preparePrint = () => {\n          if (printing) return;\n          printing = true;\n          if (document.activeElement) document.activeElement.blur();\n          hiddenForPrint.forEach(element => element.hidden = true);\n          panel.classList.remove('sticky');\n          panel.classList.add('static');\n          previousDetails = [...document.querySelectorAll('#projects details')].map(element => [element, element.open]);\n          previousDetails.forEach(([element]) => element.open = true);\n        };\n        const restorePrint = () => {\n          hiddenForPrint.forEach(element => element.hidden = false);\n          panel.classList.remove('static');\n          panel.classList.add('sticky');\n          previousDetails.forEach(([element, open]) => element.open = open);\n          printing = false;\n        };\n        window.addEventListener('beforeprint', preparePrint);\n        window.addEventListener('afterprint', restorePrint);\n        document.getElementById('print-button').addEventListener('click', () => {\n          preparePrint();\n          window.print();\n          restorePrint();\n        });\n      })();\n    "}]},{"type":"script","attributes":{"data-s<":"","body":""}}],"doctype":"<!DOCTYPE html>","head":{"type":"head","name":"Document Head","components":[{"tagName":"title","type":"text","attributes":{"id":"i93c3"},"components":[{"type":"textnode","content":"More About Madie's Research"}]},{"tagName":"meta","void":true,"attributes":{"charset":"UTF-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1.0"}},{"tagName":"meta","void":true,"attributes":{"name":"robots","content":"index,follow"}},{"tagName":"meta","void":true,"attributes":{"name":"generator","content":"GrapesJS Studio"}},{"tagName":"meta","void":true,"attributes":{"name":"description","content":"An expansion of some of my research and projects.","id":"i1ds2"}},{"tagName":"meta","void":true,"attributes":{"property":"og:title","content":"More About Madie's Research"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.googleapis.com"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","name":"CV Website","attributes":{"lang":"en"}}},"id":"SkXMxIrCM1WI6Wx5","minHeight":"500px"}],"id":"KhETv457JJEWMr7S","settings":{"slug":"cv","socialTitle":"CV","customCodeBody":""}},{"name":"More About Winnie","frames":[{"component":{"type":"wrapper","name":"CV Page","classes":["gjs-t-body","cv-page"],"attributes":{"id":"ifcg-2"},"components":[{"tagName":"header","name":"Top Navigation","classes":["top-navigation"],"attributes":{"id":"site-header-3"},"components":[{"tagName":"nav","name":"Navigation Container","classes":["navigation-container"],"attributes":{"aria-label":"Main navigation","id":"ipb61-2"},"components":[{"type":"link","name":"Home Link","editable":false,"classes":["gjs-t-link","home-link"],"attributes":{"href":"./index.html","id":"inrl4-3"},"components":[{"tagName":"span","type":"text","classes":["personal-monogram"],"attributes":{"id":"id70h-2-2"},"components":[{"type":"textnode","content":"WvS"}]},{"tagName":"span","type":"text","classes":["website-name"],"attributes":{"id":"ihcdy-2-2"},"components":[{"type":"textnode","content":"More About Winnie"}]}]},{"name":"Navigation Links","classes":["navigation-links"],"attributes":{"id":"i8x79-3"},"components":[{"type":"link","classes":["gjs-t-link","projects-cv-link"],"attributes":{"href":"./index.html","id":"iq7ov-2-2"},"components":[{"type":"textnode","content":"Mom’s Resume"}]},{"tagName":"details","classes":["more-pages-dropdown"],"attributes":{"id":"more-menu-2-2"},"components":[{"tagName":"summary","classes":["more-pages-toggle"],"attributes":{"id":"imgvj-2-2"},"components":[{"type":"textnode","content":"Explore more\n              "},{"type":"image","resizable":{"ratioDefault":1},"classes":["navigation-chevron"],"attributes":{"id":"igych-2-2","src":"https://api.iconify.design/lucide-chevron-down.svg?color=%23244b43","alt":"","width":"15","height":"15"}}]},{"classes":["gjs-t-border","more-pages-menu"],"attributes":{"id":"iw6qr-2-2"},"components":[{"type":"link","classes":["gjs-t-link","more-about-me-link"],"attributes":{"href":"./more-about-me.html","id":"ickuv-2-2"},"components":[{"type":"textnode","content":"More About Me"}]},{"type":"link","classes":["gjs-t-link","more-about-my-projects-link"],"attributes":{"href":"./cv.html","aria-current":"page","id":"i52mq-2-2"},"components":[{"type":"textnode","content":"More About My Projects"}],"hrefType":"pages"}]}]}]}]}]},{"type":"script","name":"CV Editing and Printing","components":[{"type":"textnode","content":"\n      (() => {\n        const storageKey = 'personal-cv-content-v1';\n        const fields = [...document.querySelectorAll('[data-field]')];\n        const status = document.getElementById('save-status');\n        let saved = {};\n        try {\n          saved = JSON.parse(localStorage.getItem(storageKey) || '{}');\n          fields.forEach(field => {\n            if (typeof saved[field.dataset.field] === 'string') field.textContent = saved[field.dataset.field];\n          });\n        } catch (error) {\n          status.textContent = 'Browser storage is unavailable. Print to keep a copy.';\n        }\n        let timer;\n        fields.forEach(field => {\n          field.addEventListener('input', () => {\n            status.textContent = 'Saving your changes…';\n            clearTimeout(timer);\n            timer = setTimeout(() => {\n              fields.forEach(item => saved[item.dataset.field] = item.textContent);\n              try {\n                localStorage.setItem(storageKey, JSON.stringify(saved));\n                status.textContent = 'Saved in this browser. Your changes stay on this device.';\n              } catch (error) {\n                status.textContent = 'Unable to save locally. Print to keep a copy.';\n              }\n            }, 400);\n          });\n          field.addEventListener('paste', event => {\n            event.preventDefault();\n            const text = event.clipboardData.getData('text/plain');\n            const selection = window.getSelection();\n            if (!selection.rangeCount) return;\n            const range = selection.getRangeAt(0);\n            range.deleteContents();\n            const node = document.createTextNode(text);\n            range.insertNode(node);\n            range.setStartAfter(node);\n            range.collapse(true);\n            selection.removeAllRanges();\n            selection.addRange(range);\n            field.dispatchEvent(new Event('input', {\n              bubbles: true\n            }));\n          });\n        });\n\n        const photo = document.getElementById('profile-photo');\n        try {\n          const previousPhoto = localStorage.getItem('personal-cv-photo-v1');\n          if (previousPhoto) {\n            photo.src = previousPhoto;\n            photo.classList.remove('p-5');\n            photo.alt = 'Personal profile photo';\n          }\n        } catch (error) {}\n        document.getElementById('photo-input').addEventListener('change', event => {\n          const file = event.target.files[0];\n          if (!file) return;\n          if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {\n            status.textContent = 'Please choose a JPEG, PNG, or WebP photo.';\n            return;\n          }\n          if (file.size > 3 * 1024 * 1024) {\n            status.textContent = 'Please choose a photo smaller than 3 MB.';\n            return;\n          }\n          const reader = new FileReader();\n          reader.onload = () => {\n            photo.src = reader.result;\n            photo.alt = 'Personal profile photo';\n            photo.classList.remove('p-5');\n            try {\n              localStorage.setItem('personal-cv-photo-v1', reader.result);\n              status.textContent = 'Photo saved in this browser.';\n            } catch (error) {\n              status.textContent = 'Photo added, but could not be saved locally.';\n            }\n          };\n          reader.readAsDataURL(file);\n        });\n\n        const menu = document.getElementById('more-menu');\n        menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => menu.open = false));\n        document.addEventListener('click', event => {\n          if (!menu.contains(event.target)) menu.open = false;\n        });\n        document.addEventListener('keydown', event => {\n          if (event.key === 'Escape') menu.open = false;\n        });\n\n        const panel = document.getElementById('profile-panel');\n        const hiddenForPrint = [\n          document.getElementById('site-header'),\n          document.getElementById('page-footer'),\n          ...document.querySelectorAll('.editor-control')\n        ];\n        let printing = false;\n        let previousDetails = [];\n        const preparePrint = () => {\n          if (printing) return;\n          printing = true;\n          if (document.activeElement) document.activeElement.blur();\n          hiddenForPrint.forEach(element => element.hidden = true);\n          panel.classList.remove('sticky');\n          panel.classList.add('static');\n          previousDetails = [...document.querySelectorAll('#projects details')].map(element => [element, element.open]);\n          previousDetails.forEach(([element]) => element.open = true);\n        };\n        const restorePrint = () => {\n          hiddenForPrint.forEach(element => element.hidden = false);\n          panel.classList.remove('static');\n          panel.classList.add('sticky');\n          previousDetails.forEach(([element, open]) => element.open = open);\n          printing = false;\n        };\n        window.addEventListener('beforeprint', preparePrint);\n        window.addEventListener('afterprint', restorePrint);\n        document.getElementById('print-button').addEventListener('click', () => {\n          preparePrint();\n          window.print();\n          restorePrint();\n        });\n      })();\n    "}]},{"type":"script","attributes":{"data-s<":"","body":""}},{"tagName":"main","name":"Two Column CV Layout","classes":["two-column-cv-layout"],"attributes":{"id":"cv-3","__nc":""},"components":[{"tagName":"aside","name":"Fixed Profile Panel","classes":["fixed-profile-panel"],"attributes":{"id":"profile-panel-3","aria-label":"Personal profile"},"components":[{"name":"Profile Content","classes":["profile-content"],"attributes":{"id":"ia5j7t-2"},"components":[