idth":"16","height":"16","alt":"","id":"it7tl-4"}},{"tagName":"span","type":"text","name":"Editable Location","classes":["editable-location"],"attributes":{"role":"textbox","aria-label":"Your location","data-field":"location","id":"iej1t-2"},"components":[{"type":"textnode","content":"[Norman, Oklahoma]"}]}]},{"name":"Website Contact","classes":["website-contact"],"components":[{"type":"image","name":"Website Icon","resizable":{"ratioDefault":1},"classes":["website-icon"],"attributes":{"src":"https://www.vikingcamps.com/wp-content/uploads/2024/01/linkedin-logo-linkedin-icon-transparent-free-png.webp","width":"16","height":"16","alt":"","id":"iukyr-4"}},{"tagName":"span","type":"text","name":"Editable Website","classes":["editable-website"],"attributes":{"role":"textbox","aria-label":"Your website or LinkedIn URL","data-field":"website","id":"ibiel-2"},"components":[{"type":"textnode","content":"www.linkedin.com/in/madie-v"}]}]}]},{"name":"Personal Statement","classes":["personal-statement"],"components":[{"tagName":"h2","type":"heading","name":"Personal Statement Heading","classes":["personal-statement-heading"],"components":[{"type":"textnode","content":"What drives me"}]},{"tagName":"p","type":"text","name":"Editable Personal Statement","classes":["editable-personal-statement"],"attributes":{"role":"textbox","aria-multiline":"true","aria-label":"Personal statement","data-field":"statement","id":"iu0j4-2"},"components":[{"type":"textnode","content":"I love the color yellow and my stuffed monkeys!"}]}]},{"name":"Print CV Actions","classes":["editor-control","print-cv-actions"]}]}],"locked":false},{"name":"CV Document Column","classes":["cv-document-column"],"attributes":{"id":"isigh-3"},"components":[{"classes":["cv-introduction"],"attributes":{"id":"id0fg-2-2"},"components":[{"tagName":"h2","type":"heading","classes":["gjs-t-h1","cv-page-heading"],"attributes":{"id":"iyagy-2-2"},"components":[{"type":"textnode","content":"More About Winnie"}]}]},{"classes":["editor-control","projects-editing-note"],"attributes":{"id":"irrcw-2-2"},"components":[{"classes":["editing-help"],"attributes":{"id":"ityai-2-2"},"components":[{"tagName":"p","type":"text","classes":["editing-tip"],"attributes":{"id":"ionuh-2-2"},"components":[{"type":"textnode","content":"“People should be more like animals . . . they should be more intuitive; they should not be too conscious of what they do while they do it.” - Albert Einstien"}]}]}]},{"tagName":"section","classes":["more-about-my-projects-section"],"attributes":{"id":"projects-2-2","aria-labelledby":"projects-heading","data-js":"project-showcase"},"components":[{"name":"Three Project Showcase","classes":["project-showcase-list"],"attributes":{"id":"ixt1o7-2"},"components":[{"tagName":"article","classes":["gjs-t-border","project-showcase-card"],"attributes":{"id":"isq3n4-2-2","aria-labelledby":"i9olr4","data-js":"project-card","data-project":"01"},"components":[{"name":"Project Image Panel","classes":["project-showcase-media"],"attributes":{"id":"ity1ph-2"},"components":[{"name":"Project Image Placeholder","classes":["project-image-slot"],"attributes":{"id":"ivmiqh4"},"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 01 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmvimae0bcbexjne1lzliszo5/assets/60f32db9-2905-43dc-bca8-5a26c1636699__screenshot-2026-10-27-at-18-06-12-img5844.jpg-jpeg-image-689-919-pixels.png","id":"iklqf55"}}]},{"name":"Project Image Placeholder","classes":["project-image-slot"],"attributes":{"id":"i0y76vv"},"components":[{"type":"image","name":"Project Image","resizable":{"ratioDefault":1},"classes":["project-image-preview"],"attributes":{"data-js":"preview","alt":"Project 01 image","hidden":true,"src":"data:image/svg+xml;base64,"}},{"type":"image","res